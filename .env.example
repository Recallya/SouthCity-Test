# Salin file ini menjadi .env lalu isi API key Anda.
# Cukup isi salah satu; model yang key-nya kosong dilewati otomatis.

# OpenAI (model utama, prabayar) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=isi-api-key-openai

# Google Gemini (cadangan, gratis) -> https://aistudio.google.com (menu "Get API key")
GOOGLE_API_KEY=isi-api-key-gemini

# Opsional: ganti model (format "provider:nama-model")
# LLM_MODEL=openai:gpt-5.4-mini                     <- default
# Cadangan, dicoba berurutan kalau model utama gagal/sibuk/kuota habis (Gemini Free tier: ~20 request/hari per model):
# LLM_FALLBACK_MODELS=google_genai:gemini-3.8-flash,google_genai:gemini-3.6-flash,google_genai:gemini-3.5-flash,google_genai:gemini-3.5-flash-lite
