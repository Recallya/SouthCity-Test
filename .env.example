# Salin file ini menjadi .env lalu isi API key Anda
# Ambil key gratis di https://aistudio.google.com (menu "Get API key")
GOOGLE_API_KEY=isi-api-key-anda

# Opsional: ganti model (format "provider:nama-model")
# LLM_MODEL=google_genai:gemini-3.8-flash          <- default, terbaru, tersedia di Free tier (kadang sibuk/503)
# Cadangan, dicoba berurutan kalau model utama gagal/sibuk/kuota habis (Free tier: ~20 request/hari per model):
# LLM_FALLBACK_MODELS=google_genai:gemini-3.6-flash,google_genai:gemini-3.5-flash,google_genai:gemini-3.5-flash-lite
# LLM_MODEL=google_genai:gemini-3.6-flash          <- cadangan: stabil
# LLM_MODEL=google_genai:gemini-3.1-pro-preview    <- Pro, hanya untuk tier berbayar (perlu billing di AI Studio)
# LLM_MODEL=anthropic:claude-opus-5-5              <- Claude (butuh ANTHROPIC_API_KEY, berbayar)
